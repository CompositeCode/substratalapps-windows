<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Substratal.Hub.Views.SignInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Substratal.Hub.Core.Api">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="400" Margin="24,48" VerticalAlignment="Center">
            <StackPanel Spacing="16">
                <Image x:Name="Lockup" Height="36" HorizontalAlignment="Left" AutomationProperties.Name="Substratal Apps" />

                <InfoBar x:Name="EndedBar" IsClosable="True" Severity="Informational" />
                <InfoBar x:Name="ErrorBar" IsClosable="False" Severity="Error" />

                <!-- AUTH-01 Sign in -->
                <StackPanel x:Name="CredentialsPanel" Spacing="12">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Sign in" />
                    <ComboBox
                        x:Name="EnvironmentBox"
                        HorizontalAlignment="Stretch"
                        Header="Environment"
                        DisplayMemberPath="Name"
                        ItemsSource="{x:Bind ViewModel.Environments}"
                        SelectedItem="{x:Bind ViewModel.SelectedEnvironment, Mode=TwoWay}" />
                    <TextBox
                        x:Name="EmailBox"
                        Header="Email"
                        InputScope="EmailSmtpAddress"
                        IsSpellCheckEnabled="False"
                        Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <PasswordBox
                        x:Name="PasswordBox"
                        Header="Password"
                        PasswordRevealMode="Peek"
                        PasswordChanged="OnPasswordChanged"
                        KeyDown="OnPasswordKeyDown" />
                    <CheckBox
                        x:Name="TestModeBox"
                        Content="Sign in to the test-mode account"
                        IsChecked="{x:Bind ViewModel.TestMode, Mode=TwoWay}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.SignInCommand}"
                        Content="Sign in"
                        Style="{StaticResource AccentButtonStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <HyperlinkButton Click="OnForgotPassword" Content="Forgot password?" />
                        <HyperlinkButton Click="OnCreateAccount" Content="Create an account" />
                    </StackPanel>
                </StackPanel>

                <!-- AUTH-02 Two-factor challenge -->
                <StackPanel x:Name="TwoFactorPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Two-factor authentication" />
                    <TextBlock x:Name="TwoFactorPrompt" TextWrapping="Wrap" Text="Enter the 6-digit code from your authenticator app." />
                    <TextBox
                        x:Name="CodeBox"
                        Header="Code"
                        InputScope="NumericPin"
                        IsSpellCheckEnabled="False"
                        Text="{x:Bind ViewModel.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        KeyDown="OnCodeKeyDown" />
                    <ToggleSwitch
                        Header="Use a recovery code instead"
                        IsOn="{x:Bind ViewModel.UseRecoveryCode, Mode=TwoWay}"
                        Toggled="OnRecoveryToggled" />
                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.VerifyCommand}"
                        Content="Verify"
                        Style="{StaticResource AccentButtonStyle}" />
                    <HyperlinkButton Command="{x:Bind ViewModel.BackToCredentialsCommand}" Content="Back to sign in" />
                </StackPanel>

                <HyperlinkButton x:Name="HelpLink" Content="Help with signing in" Click="OnHelp" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
