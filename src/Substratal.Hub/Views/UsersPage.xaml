<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Substratal.Hub.Views.UsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Substratal.Hub.Core.ViewModels">

    <!-- USR-01 Users. Windows container: page with table (ListView + header grid). -->
    <Grid Margin="36,0,36,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                PlaceholderText="Search by name, email or usr_ ID"
                AutomationProperties.Name="Search users"
                Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
                x:Name="StatusBox"
                Grid.Column="1"
                MinWidth="150"
                AutomationProperties.Name="Status"
                SelectionChanged="OnStatusChanged" />
            <CommandBar Grid.Column="3" DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed">
                <AppBarButton Command="{x:Bind ViewModel.ReloadCommand}" Icon="Refresh" Label="Refresh" />
                <AppBarButton x:Name="InviteButton" Click="OnInvite" Icon="AddFriend" Label="Invite user" />
            </CommandBar>
        </Grid>

        <InfoBar Grid.Row="1" IsClosable="False" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind ViewModel.ReloadCommand}" Content="Retry" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Column header -->
        <Grid Grid.Row="2" Padding="12,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Email" />
            <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="Status" />
            <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" Text="2FA" />
            <TextBlock Grid.Column="3" Style="{StaticResource CaptionTextBlockStyle}" Text="Last sign-in" />
            <TextBlock Grid.Column="4" Style="{StaticResource CaptionTextBlockStyle}" Text="Created" />
            <TextBlock Grid.Column="5" Style="{StaticResource CaptionTextBlockStyle}" Text="ID" />
        </Grid>

        <Grid Grid.Row="3">
            <ListView
                x:Name="List"
                IsItemClickEnabled="True"
                ItemClick="OnUserClick"
                ItemsSource="{x:Bind ViewModel.Users}"
                SelectionMode="Extended">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:UserRow">
                        <Grid Padding="0,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Email}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Status}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind MfaEnabled}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind LastLogin}" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Created}" />
                            <TextBlock Grid.Column="5" Style="{StaticResource IdTextStyle}" Text="{x:Bind Id}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No users match."
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
        </Grid>

        <Button
            Grid.Row="4"
            HorizontalAlignment="Center"
            Command="{x:Bind ViewModel.LoadMoreCommand}"
            Content="Load more"
            Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}" />
    </Grid>
</Page>
