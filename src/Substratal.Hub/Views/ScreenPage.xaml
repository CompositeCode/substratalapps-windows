<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Substratal.Hub.Views.ScreenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A screen from windows/SCREENS.md that this build doesn't implement yet. It shows the spec's own description,
         so the shell, routes and navigation can be exercised end to end before each screen is built. -->
    <ScrollViewer>
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="880" HorizontalAlignment="Left" Spacing="16">
            <HyperlinkButton x:Name="BackLink" Content="← Back to sign in" Click="OnBack" Visibility="Collapsed" />
            <TextBlock x:Name="OutsideTitle" Style="{StaticResource TitleTextBlockStyle}" Visibility="Collapsed" />

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Severity="Informational"
                Title="Not built yet"
                Message="This screen is specified and routed, but not implemented in this build." />

            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="24" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Screen" />
                    <TextBlock x:Name="IdText" Grid.Row="0" Grid.Column="1" Style="{StaticResource IdTextStyle}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Purpose" />
                    <TextBlock x:Name="PurposeText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Who" />
                    <TextBlock x:Name="WhoText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Area" />
                    <TextBlock x:Name="DomainText" Grid.Row="3" Grid.Column="1" />
                    <TextBlock Grid.Row="4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Route" />
                    <TextBlock x:Name="RouteText" Grid.Row="4" Grid.Column="1" Style="{StaticResource IdTextStyle}" />
                    <TextBlock Grid.Row="5" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Phase" />
                    <TextBlock x:Name="PhaseText" Grid.Row="5" Grid.Column="1" />
                    <TextBlock Grid.Row="6" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Windows container" />
                    <TextBlock x:Name="ContainerText" Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <TextBlock x:Name="ParameterText" Style="{StaticResource IdTextStyle}" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnHelp" Content="Help for this screen" Style="{StaticResource AccentButtonStyle}" />
                <Button Click="OnSpec" Content="Open the spec" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
