<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Substratal.Hub.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Last, so the Substratal theme overrides (accent, text, surfaces) win over the stock ones. -->
                <ResourceDictionary Source="ms-appx:///Theming/SubstratalThemes.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- PLATFORM-SPEC §5: IDs in Cascadia Mono; page padding 36 epx (24 compact). -->
            <FontFamily x:Key="IdFontFamily">Cascadia Mono, Consolas</FontFamily>
            <Thickness x:Key="PagePadding">36,24,36,36</Thickness>
            <Thickness x:Key="PagePaddingCompact">24,16,24,24</Thickness>
            <x:Double x:Key="SettingsCardMinHeight">68</x:Double>

            <Style x:Key="IdTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontFamily" Value="{StaticResource IdFontFamily}" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
