<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that isn't UI: the generated API client, sessions, Capabilities, the screen registry,
       help links and view models. Cross-platform (net10.0) so it builds and tests on Linux and macOS CI,
       against the real API devserver. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Substratal.Hub.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Substratal.Hub.Core.Tests" />
  </ItemGroup>
</Project>
